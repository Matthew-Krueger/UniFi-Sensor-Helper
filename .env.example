# Copy to .env and fill in real values. Never commit .env.
# See CLAUDE.md — the coding agent must never read the real .env file.

# Bootstrap admin account, seeded into the users table on first boot only
# (ignored once at least one user exists — manage further accounts via the
# Users settings page instead of editing these).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Used to sign session cookies. Generate a long random value, e.g.:
#   openssl rand -base64 48
SESSION_SECRET=changeme-generate-a-long-random-value

# HTTPS — self-signed cert/key paths (see DEPLOY.md for generation command).
# Never commit the actual cert/key files.
TLS_CERT_PATH=./certs/dev-cert.pem
TLS_KEY_PATH=./certs/dev-key.pem

PORT=8443

# Where the SQLite database file lives (sensors, latches, latch state, users).
DATABASE_PATH=./data/app.db

# UniFi Protect console connection — filled in once API discovery (see
# API_NOTES.md) confirms the exact auth header/shape. Placeholder names only.
PROTECT_HOST=
PROTECT_API_KEY=
