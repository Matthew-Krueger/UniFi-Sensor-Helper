{
  "name": "unifi-sensor-latch",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run apps/web/server.ts",
    "build": "bun --filter web build",
    "start": "NODE_ENV=production bun run apps/web/server.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate --config packages/engine/drizzle.config.ts",
    "db:migrate": "bun run packages/engine/src/migrate.ts"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
